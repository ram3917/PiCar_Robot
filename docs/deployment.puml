@startuml deployment
title PiCar_Robot - build and deployment

actor Developer

node "Dev machine (Docker, buildx)" as dev {
  component "docker buildx\n--platform linux/arm64" as build
  component "picar.tar\n(docker save)" as tar
}

node "Raspberry Pi 3B+ (64-bit Raspberry Pi OS, Docker)" as pi {
  component "docker load" as load
  component "docker compose\n(docker/compose.yaml)" as compose
  component "picar container\nROS 2 Jazzy, network_mode: host" as container
}

node "PiCar-4WD HAT" as hat

Developer --> build : docker/Dockerfile
build --> tar
tar --> load : scp
load --> compose
compose --> container : restart: unless-stopped
container --> hat : /dev/i2c-1, /dev/gpiomem,\n/dev/gpiochip0

@enduml
