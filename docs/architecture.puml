@startuml architecture
title PiCar_Robot - components

skinparam componentStyle rectangle

actor Operator

package "picar (ROS 2 package)" {
  component "controller\n(the only hardware owner)" as controller
  component "planner\n(drive parameter)" as planner
  component "MotorGovernor\n(Twist mixing + safety)" as governor
  component "ReactivePlanner" as reactive
  interface "RobotHardware" as hw
  component "FakeRobot\n(hardware:=fake)" as fake
  component "Picar4WDHardware\n(hardware:=picar4wd)" as adapter
}

node "PiCar-4WD HAT" as hat {
  component "Ultrasonic sensor" as sonar
  component "Greyscale ADC x3" as grey
  component "Servo\n(locked forward)" as servo
  component "Motors x4" as motors
}

controller --> planner : /controller/range\n(also greyscale and joint states), ~30 ms
planner --> controller : /cmd_vel\ngeometry_msgs/Twist, 10 Hz
Operator --> planner : ros2 param set /planner drive true

controller ..> governor : uses
planner ..> reactive : uses
controller ..> hw : set_motor_power() / stop()\nread_range_m() / read_greyscale()

fake ..|> hw
adapter ..|> hw

adapter --> sonar
adapter --> grey
adapter --> servo
adapter --> motors

@enduml
