@startuml architecture
title PiCar_Robot - overview

skinparam componentStyle rectangle

node "Dev machine" as dev {
  component "Docker buildx\n(arm64 image)" as build
}

node "Raspberry Pi 3B+ (Docker, ROS 2 Jazzy)" as pi {
  component "planner\nstop > reverse > turn > cruise\n(drive switch, off by default)" as planner
  component "controller\nonly hardware owner\nsafety limits" as controller
  interface "RobotHardware\n(fake / picar4wd)" as hw
  database "rosbag2\n(optional)" as bag
}

node "PiCar-4WD HAT" as hat {
  component "Ultrasonic sensor" as sonar
  component "Motors x4" as motors
}

controller --> planner : /controller/range
planner --> controller : /cmd_vel (Twist)
controller ..> hw
hw --> sonar
hw --> motors
controller ..> bag : record
planner ..> bag : record

build --> pi : docker save, scp,\ndocker load, compose up

note bottom of planner
  Any node publishing /cmd_vel
  can replace the planner.
end note

@enduml
