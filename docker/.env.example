# Copy this file to docker/.env on the Pi and edit it. docker compose reads it.

# The picar release to run: a version from a v<version> tag and GitHub Release, such as 0.3.0.
# install_picar.sh installs it. Changing this line does nothing until you run install_picar.sh.
PICAR_VERSION=0.3.0

# The base image tag compose runs (the image you copied to the Pi with scp).
IMAGE_TAG=latest

# Set true to let the planner drive. Keep false unless you intend the robot to move.
PICAR_DRIVE=false
