// Development environment for VS Code (Dev Containers / Reopen in Container).
// Built from the same docker/Dockerfile as docker/compose.yaml, so dev and the robot image
// share one definition. Robot hardware is not available here: use hardware:=fake.
{
  "name": "PiCar_Robot (ROS 2 Jazzy)",
  "build": {
    "dockerfile": "../docker/Dockerfile",
    "context": ".."
  },
  // The image's ENTRYPOINT starts the robot launch file. Replace it with a shell so VS Code's
  // keep-alive command runs instead, and the dev container stays up without starting the robot.
  "runArgs": ["--entrypoint=/bin/sh", "--shm-size=1g"],
  // A desktop in the browser for rviz2, rqt and PlotJuggler (no X server needed on Windows).
  // Open http://localhost:6080 (password: noPassword) once the container is running, then run
  // `ros2 launch picar manual_test.launch.py` in a terminal.
  "features": {
    "ghcr.io/devcontainers/features/desktop-lite:1": {
      "password": "noPassword"
    }
  },
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": { "label": "Desktop (rviz2, rqt, PlotJuggler)", "onAutoForward": "notify" }
  },
  "containerEnv": {
    "PYTHONUNBUFFERED": "1",
    // The desktop has no GPU, so OpenGL (rviz2) renders in software.
    "LIBGL_ALWAYS_SOFTWARE": "1"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-iot.vscode-ros",
        "redhat.vscode-xml",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/bin/python3",
        "python.testing.pytestEnabled": true,
        "python.testing.unittestEnabled": false,
        "python.testing.pytestArgs": ["picar"],
        "python.testing.cwd": "${workspaceFolder}",
        "files.eol": "\n"
      }
    }
  }
}
